{
  automerge: true,
  platformAutomerge: false,
  minimumReleaseAge: "7 days",
  extends: [
    "config:best-practices",
    "group:allNonMajor",
    "group:definitelyTyped",
  ],
  rangeStrategy: "bump",
  prConcurrentLimit: 0,
  prHourlyLimit: 0,
  commitBodyTable: true,
  dependencyDashboard: true,
  postUpdateOptions: ["yarnDedupeHighest"],
  packageRules: [
    {
      description: "Keep npm release age in sync with pnpm minimumReleaseAge (security:minimumReleaseAgeNpm sets 3 days)",
      matchDatasources: ["npm"],
      matchUpdateTypes: ["major", "minor", "patch"],
      minimumReleaseAge: "7 days",
    },
  ],
  // automerge: true,
}
